# Required for copy generation. Keep the real value in the process environment.
LUNA_API_KEY=

# The application appends /v1/chat/completions to this fixed base URL.
LUNA_API_BASE_URL=http://43.165.167.179:18241
LUNA_MODEL=gpt-6-luna
LUNA_REASONING_EFFORT=max

# The default is 15 minutes. The first run happens immediately unless disabled.
POST_INTERVAL_MINUTES=15
RUN_ON_START=true
NEWS_MAX_LINKS=36
LLM_TIMEOUT_MS=120000

# Set true for a safe content/preflight cycle without submitting to Square.
DRY_RUN=false
