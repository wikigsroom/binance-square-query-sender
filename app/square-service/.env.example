# Native Node; no container required. Never commit real credentials.
HOST=127.0.0.1
PORT=4310
PUBLIC_ORIGIN=http://localhost:4300
DATA_DIR=./data
# A PostgreSQL URL enables separate API/worker processes. Blank = one-process PGlite development.
DATABASE_URL=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
ADMIN_USERNAME=owner
ADMIN_PASSWORD=
COOKIE_SECURE=false
RUN_WORKER=true
SQUARE_PUBLISH_ENABLED=false
OUTBOUND_PROXY_URL=
# Explicit controlled migration roots, separated by semicolons. Default: disabled.
IMPORT_ROOTS=
# Optional: serve the dashboard production build from this API (same origin).
WEB_DIR=
