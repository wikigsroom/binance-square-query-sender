# Credentials, private deployment state and preserved component Git histories.
.private/
**/.private/
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
/keys.txt
/accounts.json
/settings.json
/posts.json
/selected-image.json
/skill-load-check.json
/skill-package-check.json
*.pem
*.key
*.p12

# Dependencies, builds, caches, browser profiles and local databases.
**/node_modules/
**/.npm-cache/
**/.tmp/
**/__pycache__/
**/*.pyc
**/dist/
**/data/
**/coverage/
**/.browsers/
**/browser-temp/
**/test-results/
**/playwright-report/
**/.run.lock
**/state/
/batches/
/runs/
/snapshots/
*.log
*.tsbuildinfo

# Local media libraries, runtime archives and detailed private diagnostics.
/imagegen/*
!/imagegen/README.md
/app/deployment/artifacts/
/docs/development/releases/*
!/docs/development/releases/README.md
!/docs/development/releases/manifest.json
!/docs/development/releases/manifest-v0.1.0.json
/docs/publishing-validation/*-diagnostic.json
/docs/publishing-validation/publish-first-operation.json
*.zip
*.tar
*.tar.gz
*.tgz
*.bundle

