      "presetName": "GameFi 与应用｜先好玩再谈代币",
      "presetId": "preset_3f45a874-f4c7-48ad-9508-998ebe2c10d5",
      "jobId": "job_953ea515-a89e-44b9-b122-1f1997787c52",
      "state": "preview_ready",
